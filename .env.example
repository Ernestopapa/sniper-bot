# Copy to .env and fill in. NEVER commit a real .env, and NEVER paste a
# private key into chat, a ticket, or a shared doc.
#
# BSC RPC. A paid WebSocket endpoint is strongly recommended for live use;
# public endpoints are too slow and rate-limited for sniping.
BSC_RPC_URL=wss://bsc-mainnet.example-provider.com/ws
BSC_HTTP_URL=https://bsc-dataseed.binance.org/

# Wallet used ONLY for sniping. Use a fresh wallet with only funds you can
# afford to lose. This bot never uses a Binance Agentic Wallet / baw wallet:
# baw needs app confirmation, which is too slow for a snipe.
SNIPE_PRIVATE_KEY=

# Safety defaults. Leave these alone until you have paper-tested for a week.
DRY_RUN=true
LIVE_TRADING=false
CONFIRM_LIVE=
MAX_BUY_BNB=0.01
MAX_GAS_GWEI=5
MAX_TAX_PERCENT=10
MIN_LIQUIDITY_BNB=1
SELL_TAKE_PROFIT_1=2
SELL_TAKE_PROFIT_2=5
SELL_STOP_LOSS=0.65

# NFT watchlist: contract addresses to poll, comma-separated.
# Example: 0x42dbe11400a6dd3c92710fd275f8ca1193830022
NFT_CONTRACTS=

# Token pair factory to watch (PancakeSwap V2 factory on BSC).
PANCAKE_FACTORY=0xca143ce32fe78f1f7019d7d551a6402fc5350c73
WBNB=0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc381
PANCAKE_ROUTER=0x10ED43C718714eb63d5aA57B78B54704E256024E
